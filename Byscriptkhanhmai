		"Fly Speed: " ..
		tostring(FlySpeed)

end)

--============================================================
-- CHECK KEY
--============================================================

local function CheckKey(Key)

	Key =
		tostring(Key or "")

	Key =
		Key:gsub("^%s+", "")
			:gsub("%s+$", "")

	if Key == "" then
		return nil
	end

	return VALID_KEYS[Key]
end

