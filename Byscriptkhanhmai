--============================================================
-- TIMER
--============================================================

task.spawn(function()

    while ScreenGui
        and ScreenGui.Parent do

        if ActiveKey
            and KeyDuration
            and KeyStartTime then

            if KeyDuration == math.huge then

                KeyTimer.Text =
                    "Key: VĨNH VIỄN"

            else

                local Elapsed =
                    os.time() -
                    KeyStartTime

                local Remaining =
                    KeyDuration -
                    Elapsed

                if Remaining <= 0 then

                    if StopFly then
                        StopFly()
                    end

                    ActiveKey = nil
                    KeyStartTime = nil
                    KeyDuration = nil

                    MainFrame.Visible =
                        false

                    FlyPanel.Visible =
                        false

                    KeyFrame.Visible =
                        true

                    KeyInput.Text = ""

                    Status.Text =
                        "✕ KEY ĐÃ HẾT HẠN"

                    Status.TextColor3 =
                        Color3.fromRGB(
                            255,
                            70,
                            70
                        )

                    InputStroke.Color =
                        Color3.fromRGB(
                            255,
                            70,
                            70
                        )

                else

                    KeyTimer.Text =
                        "Key: " ..
                        FormatTime(Remaining)

                end
            end
        end

        task.wait(1)
    end

end)

