local KEY_CACHE_FILE = "tien_chicago_key_cache_v45.json"

local function saveKeyData(keyType, expireTime)
    pcall(function()
        if writefile and isfolder then
            local data = HttpService:JSONEncode({Type = keyType, Expire = expireTime})
            writefile(KEY_CACHE_FILE, data)
        end
    end)
end

local function loadKeyData()
    local success, res = pcall(function()
        if readfile and isfile and isfile(KEY_CACHE_FILE) then
            local raw = readfile(KEY_CACHE_FILE)
            return HttpService:JSONDecode(raw)
        end
    end)
    if success and res then return res end
    return nil
end

local function clearKeyData()
    pcall(function()
        if delfile and isfile and isfile(KEY_CACHE_FILE) then
            delfile(KEY_CACHE_FILE)
        end
    end)
end

local function makeDraggable(topbarObject, object)
    local dragging, dragInput, dragStart, startPos
    
    topbarObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    topbarObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

