--==================================================
-- KEY SYSTEM LOGIC
--==================================================
local function startMainUI()
    keyFrame:Destroy()
    main.Visible = true
    keyTimerLabel.Visible = true
    showWelcomeNotification()
end

local cachedData = loadKeyData()
if cachedData then
    if cachedData.Type == "Permanent" then
        startMainUI()
        task.spawn(function()
            while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end
        end)
    elseif cachedData.Expire and tick() < cachedData.Expire then
        startMainUI()
        task.spawn(function()
            while true do
                local timeLeft = cachedData.Expire - tick()
                if timeLeft > 0 then
                    local days = math.floor(timeLeft / 86400)
                    local remAfterDays = timeLeft % 86400
                    local h = math.floor(remAfterDays / 3600)
                    local m = math.floor((remAfterDays % 3600) / 60)
                    local s = math.floor(remAfterDays % 60)
                    
                    if days > 0 then
                        keyTimerLabel.Text = string.format("🔑 Key còn: %d ngày %02d:%02d:%02d", days, h, m, s)
                    else
                        keyTimerLabel.Text = string.format("🔑 Key còn: %02d:%02d:%02d", h, m, s)
                    end
                else
                    clearKeyData()
                    main.Visible = false
                    gui:Destroy()
                    break
                end
                task.wait(1)
            end
        end)
    else
        clearKeyData()
    end
end

enter.MouseButton1Click:Connect(function()
    local enteredKey = input.Text:gsub("%s+", "")
    if enteredKey == "tien-keyvinhvien" then
        saveKeyData("Permanent", 0)
        startMainUI()
        task.spawn(function()
            while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end
        end)
    elseif enteredKey == "tien-key1thang" then
        local expTime = tick() + 2592000
        saveKeyData("Month", expTime)
        startMainUI()
        task.spawn(function()
            while true do
                local timeLeft = expTime - tick()
                if timeLeft > 0 then
                    local days = math.floor(timeLeft / 86400)
                    local remAfterDays = timeLeft % 86400
                    local h = math.floor(remAfterDays / 3600)
                    local m = math.floor((remAfterDays % 3600) / 60)
                    local s = math.floor(remAfterDays % 60)
                    keyTimerLabel.Text = string.format("🔑 Key còn: %d ngày %02d:%02d:%02d", days, h, m, s)
                else
                    break
                end
                task.wait(1)
            end
        end)
    elseif enteredKey ~= "" and string.len(enteredKey) >= 4 then
        local expTime = tick() + 21600
        saveKeyData("Temporary", expTime)
        startMainUI()
        task.spawn(function()
            while true do
                local timeLeft = expTime - tick()
                if timeLeft > 0 then
                    local h = math.floor(timeLeft / 3600)
                    local m = math.floor((timeLeft % 3600) / 60)
                    local s = math.floor(timeLeft % 60)
                    keyTimerLabel.Text = string.format("🔑 Key còn: %02d:%02d:%02d", h, m, s)
                else
                    break
                end
                task.wait(1)
            end
        end)
    else
        keyStatusText.TextColor3 = Color3.fromRGB(230, 60, 60)
        keyStatusText.Text = "❌ Sai Key hợp lệ!"
    end
end)

