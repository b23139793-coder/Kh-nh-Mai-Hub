addButton(aim, "🔫 VÔ HẠN ĐẠN CỰC ĐẠI", 120, function(state)
    infiniteAmmoEnabled = state
    task.spawn(function()
        while infiniteAmmoEnabled do
            task.wait(0.1)
            pcall(function()
                local maxInfVal = 99999999999999999999999999999999999999999999
                if getgc and setreadonly and rawset then
                    for _, obj in next, getgc(true) do
                        if type(obj) == "table" then
                            if rawget(obj, "Ammo") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "Ammo", maxInfVal)
                            end
                            if rawget(obj, "MaxAmmo") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "MaxAmmo", maxInfVal)
                            end
                            if rawget(obj, "ClipSize") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "ClipSize", maxInfVal)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

