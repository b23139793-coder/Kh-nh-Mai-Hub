local cartp = makePage("CAR TP")

local carTpInfo = Instance.new("TextLabel")
carTpInfo.Size = UDim2.new(1, -20, 0, 42)
carTpInfo.Position = UDim2.fromOffset(10, 10)
carTpInfo.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
carTpInfo.Text = "🚗 CHỌN PLAYER ĐỂ NGỒI XE VÀ TP ĐẾN ĐÓ"
carTpInfo.TextColor3 = Color3.fromRGB(255, 255, 255)
carTpInfo.TextSize = 12
carTpInfo.Font = Enum.Font.GothamBold
carTpInfo.Parent = cartp
Instance.new("UICorner", carTpInfo).CornerRadius = UDim.new(0, 10)

local playerListContainer = Instance.new("ScrollingFrame")
playerListContainer.Size = UDim2.new(1, -20, 1, -70)
playerListContainer.Position = UDim2.fromOffset(10, 60)
playerListContainer.BackgroundTransparency = 1
playerListContainer.BorderSizePixel = 0
playerListContainer.ScrollBarThickness = 4
playerListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
playerListContainer.Parent = cartp

local function refreshCarTpList()
    for _, child in pairs(playerListContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local yOffset = 0
    local activePlayers = Players:GetPlayers()
    
    playerListContainer.CanvasSize = UDim2.new(0, 0, 0, #activePlayers * 45)
    
    for _, plr in ipairs(activePlayers) do
        if plr ~= player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 40)
            btn.Position = UDim2.fromOffset(0, yOffset)
            btn.BackgroundColor3 = Color3.fromRGB(230, 230, 240)
            btn.Text = "👤 " .. (plr.DisplayName or plr.Name) .. " (@" .. plr.Name .. ")"
            btn.TextColor3 = Color3.fromRGB(0, 0, 0)
            btn.TextSize = 13
            btn.Font = Enum.Font.GothamBold
            btn.Parent = playerListContainer
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
            
            btn.MouseButton1Click:Connect(function()
                pcall(function()
                    local char = player.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                    
                    local targetChar = plr.Character
                    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
                    
                    -- Tìm xe (VehicleSeat/Seat) gần nhất với người chơi
                    local nearestSeat = nil
                    local shortestDist = math.huge
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("VehicleSeat") or (obj:IsA("Seat") and obj.Parent:FindFirstChild("Body")) then
                            local dist = (char.HumanoidRootPart.Position - obj.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                nearestSeat = obj
                            end
                        end
                    end
                    
                    if nearestSeat then
                        -- Ngồi lên xe và gán CFrame của xe đến vị trí target để chống văng/vát map
                        nearestSeat:Sit(char.Humanoid)
                        task.wait(0.15)
                        local carModel = nearestSeat.Parent
                        if carModel and carModel:IsA("Model") and carModel.PrimaryPart then
                            carModel:SetPrimaryPartCFrame(targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0))
                        elseif nearestSeat.Parent and nearestSeat.Parent.Parent and nearestSeat.Parent.Parent:IsA("Model") then
                            local model = nearestSeat.Parent.Parent
                            if model.PrimaryPart then
                                model:SetPrimaryPartCFrame(targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0))
                            else
                                nearestSeat.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
                            end
                        else
                            nearestSeat.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
                        end
                    else
                        -- Nếu không tìm thấy xe gần đó, dịch chuyển trực tiếp gốc nhân vật an toàn
                        char.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
                    end
                end)
            end)
            
            yOffset = yOffset + 45
        end
    end
end

Players.PlayerAdded:Connect(refreshCarTpList)
Players.PlayerRemoving:Connect(refreshCarTpList)
task.spawn(refreshCarTpList)

