--==================================================
-- RENDER LOOP
--==================================================
RunService.RenderStepped:Connect(function()
    local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
    mainStroke.Color = rainbowColor
    pfStroke.Color = rainbowColor

    local currentLaserColor = nil
    if redLaserEnabled then currentLaserColor = Color3.fromRGB(255, 0, 0)
    elseif greenLaserEnabled then currentLaserColor = Color3.fromRGB(0, 255, 0)
    elseif rainbowLaserEnabled then currentLaserColor = rainbowColor end

    if currentLaserColor and player.Character then
        pcall(function()
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then
                local handle = tool:FindFirstChild("Handle")
                for _, obj in pairs(tool:GetDescendants()) do
                    if obj:IsA("BasePart") and obj ~= handle then
                        obj.Color = currentLaserColor
                        obj.Material = Enum.Material.Neon
                    elseif obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") then
                        obj.Color = ColorSequence.new(currentLaserColor)
                    end
                end
            end
        end)
    end

    local gameCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    aimFOV.Position = gameCenter
    displayFOV360.Position = gameCenter
    centerDot.Position = gameCenter

    if godmodEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth
    end

    if noclipEnabled and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if aimHeadEnabled then
        local closestTarget = nil
        local shortestDist = fovRadius
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                if not (teamCheckEnabled and player.Team and plr.Team and player.Team == plr.Team) then
                    local targetPart = plr.Character:FindFirstChild("Head") or plr.Character.HumanoidRootPart
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - gameCenter).Magnitude
                        if mouseDist < shortestDist then
                            shortestDist = mouseDist
                            closestTarget = targetPart
                        end
                    end
                end
            end
        end
        if closestTarget then Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position) end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            if hitboxEnabled then
                pcall(function()
                    hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    hrp.Shape = Enum.PartType.Ball
                    hrp.Color = Color3.fromRGB(255, 255, 255)
                    hrp.Transparency = 0.55
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                end)
            else
                pcall(function()
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Shape = Enum.PartType.Block
                    hrp.Transparency = 1
                end)
            end
        end
    end

    local humanCount = 0
    local robotCount = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local char = plr.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid

            if humanoid.Health > 0 then
                if Players:GetPlayerFromCharacter(char) then
                    humanCount = humanCount + 1
                else
                    robotCount = robotCount + 1
                end
            end

            if not espCache[plr] then
                espCache[plr] = {
                    Box = Drawing.new("Square"),
                    Tracer = Drawing.new("Line"),
                    HealthBarBg = Drawing.new("Square"),
                    HealthBarFill = Drawing.new("Square")
                }
                
                espCache[plr].Box.Visible = false
                espCache[plr].Box.Thickness = 1.5
                espCache[plr].Box.Color = Color3.fromRGB(255, 255, 255)
                espCache[plr].Box.Filled = false

                espCache[plr].Tracer.Visible = false
                local tLine = espCache[plr].Tracer
                tLine.Visible = false
                tLine.Thickness = 1.5
                tLine.Color = Color3.fromRGB(255, 255, 255)

                espCache[plr].HealthBarBg.Visible = false
                espCache[plr].HealthBarBg.Filled = true
                espCache[plr].HealthBarBg.Color = Color3.fromRGB(30, 30, 30)

                espCache[plr].HealthBarFill.Visible = false
                espCache[plr].HealthBarFill.Filled = true
                espCache[plr].HealthBarFill.Color = Color3.fromRGB(0, 255, 0)
            end

            local cache = espCache[plr]
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen and anyEspActive and humanoid.Health > 0 then
                local boxSize = Vector2.new(2200 / vector.Z, 3300 / vector.Z)
                local boxPos = Vector2.new(vector.X - boxSize.X / 2, vector.Y - boxSize.Y / 2)

                if espBoxesEnabled then
                    cache.Box.Visible = true
                    cache.Box.Size = boxSize
                    cache.Box.Position = boxPos
                else
                    cache.Box.Visible = false
                end

                if espTracersEnabled then
                    cache.Tracer.Visible = true
                    cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                    cache.Tracer.To = Vector2.new(vector.X, vector.Y)
                else
                    cache.Tracer.Visible = false
                end

                if espHealthEnabled then
                    local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barHeight = boxSize.Y
                    local currentBarHeight = barHeight * healthPercent

                    cache.HealthBarBg.Visible = true
                    cache.HealthBarBg.Size = Vector2.new(3.5, barHeight)
                    cache.HealthBarBg.Position = Vector2.new(boxPos.X - 6, boxPos.Y)

                    cache.HealthBarFill.Visible = true
                    cache.HealthBarFill.Size = Vector2.new(3.5, currentBarHeight)
                    cache.HealthBarFill.Position = Vector2.new(boxPos.X - 6, boxPos.Y + (barHeight - currentBarHeight))
                else
                    cache.HealthBarBg.Visible = false
                    cache.HealthBarFill.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.Tracer.Visible = false
                cache.HealthBarBg.Visible = false
                cache.HealthBarFill.Visible = false
            end
        else
            if espCache[plr] then
                espCache[plr].Box.Visible = false
                espCache[plr].Tracer.Visible = false
                espCache[plr].HealthBarBg.Visible = false
                espCache[plr].HealthBarFill.Visible = false
            end
        end
    end

    counterLabel.Text = string.format("👤 %d   🤖 %d", humanCount, robotCount)
end)
