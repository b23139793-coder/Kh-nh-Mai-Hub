task.spawn(function()
    local lastUpdate = 0
    local frameCount = 0
    local currentFps = 60
    
    RunService.RenderStepped:Connect(function(dt)
        frameCount = frameCount + 1
        if tick() - lastUpdate >= 1 then
            currentFps = math.floor(frameCount / (tick() - lastUpdate))
            frameCount = 0
            lastUpdate = tick()
        end
        local currentDate = os.date("%d/%m/%Y")
        infoTopLabel.Text = string.format("FPS: %d | %s", currentFps, currentDate)
    end)
end)

