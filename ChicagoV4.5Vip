slider.BackgroundColor3 = Color3.fromRGB(230, 230, 240)
slider.TextSize = 14
slider.Font = Enum.Font.GothamBold
slider.Parent = aim

local sc = Instance.new("UICorner")
sc.CornerRadius = UDim.new(0, 10)
sc.Parent = slider

slider.FocusLost:Connect(function()
    local val = tonumber(slider.Text)
    if val then
        hitboxSize = math.clamp(val, 2, 50)
        hitboxValue.Text = "KÍCH THƯỚC HITBOX: " .. tostring(hitboxSize)
    else
        slider.Text = tostring(hitboxSize)
    end
end)

--==================================================
-- TAB: SPIN & PLAYER MODS
--==================================================
local spin = makePage("SPIN")
addButton(spin, "🌀 SPIN", 10, function(state)
    spinEnabled = state
    task.spawn(function()
        while spinEnabled do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(60), 0)
            end
            task.wait()
        end
    end)
end)

addButton(spin, "🛡 BẤT TỬ (GODMODE)", 65, function(state) godmodEnabled = state end)
addButton(spin, "👻 ĐI XUYÊN TƯỜNG (NOCLIP)", 120, function(state) noclipEnabled = state end)

addButton(spin, "⚡ CHỐNG LAG (ANTI-LAG)", 175, function(state)
    antiLagEnabled = state
    if antiLagEnabled then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.Brightness = 2
            Lighting.FogEnd = 999999
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end
            end
        end)
    end
end)

