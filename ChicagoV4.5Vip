    displayFOV360.Visible = state
end)

addButton(aim, "🔫 VÔ HẠN ĐẠN CỰC ĐẠI", 120, function(state)
    infiniteAmmoEnabled = state
    task.spawn(function()
        while infiniteAmmoEnabled do
            task.wait(0.1)
            pcall(function()
                local maxInfVal = 99999999999999999999999999999999999999999999
                if getgc and setreadonly and rawset then
                    for _, obj in next, getgc(true) do
                        if type(obj) == "table" then
                            if rawget(obj, "Ammo") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "Ammo", maxInfVal)
                            end
                            if rawget(obj, "MaxAmmo") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "MaxAmmo", maxInfVal)
                            end
                            if rawget(obj, "ClipSize") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "ClipSize", maxInfVal)
                            end
                            if rawget(obj, "BulletsPerShot") or rawget(obj, "BulletPerShot") or rawget(obj, "Count") then
                                if isreadonly(obj) then setreadonly(obj, false) end
                                rawset(obj, "BulletsPerShot", maxInfVal)
                                rawset(obj, "BulletPerShot", maxInfVal)
                                rawset(obj, "Count", maxInfVal)
                            end
                        end
                    end
                end

                local function forceFixAmmo(container)
                    if not container then return end
                    for _, obj in pairs(container:GetChildren()) do
                        if obj:IsA("Tool") then
                            for _, v in pairs(obj:GetDescendants()) do
                                if v:IsA("IntValue") or v:IsA("NumberValue") then
                                    local name = v.Name:lower()
                                    if name:find("ammo") or name:find("clip") or name:find("bullet") or name:find("magazine") or name:find("rounds") or name:find("count") then
                                        v.Value = 999999999
                                    end
                                end
                            end
                        end
                    end
                end

                if player.Character then
                    forceFixAmmo(player.Character)
                end
                local backpack = player:FindFirstChildOfClass("Backpack")
                if backpack then
                    forceFixAmmo(backpack)
                end
            end)
        end
    end)
end)

