local bypass = makePage("BYPASS")
addButton(bypass, "🔐 TRẠNG THÁI KEY: AN TOÀN", 10, function(state) end)
addButton(bypass, "🌐 LẤY LẠI LINK GETKEY", 65, function(state)
    if setclipboard then setclipboard(GETKEY_URL) end
end)

--==================================================
-- MENU NAVIGATION BUTTONS CREATION
--==================================================
local names = {"EXP", "AIM", "SPIN", "BYPASS"}

for i, name in ipairs(names) do
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 48)
    b.Position = UDim2.fromOffset(0, (i - 1) * 56)
    b.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
    b.Text = name
    b.TextColor3 = Color3.fromRGB(0, 0, 0)
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.Parent = menu

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do
            p.Visible = false
        end
        pages[name].Visible = true
    end)
end

pages.EXP.Visible = true

--==================================================
-- XỬ LÝ CHECK CACHE KEY KHI KHỞI ĐỘNG
--==================================================
local cachedData = loadKeyData()
if cachedData then
    if cachedData.Type == "Permanent" then
        keyFrame.Visible = false
        main.Visible = true
        keyTimerLabel.Visible = true
        task.spawn(function()
            while true do
                keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"
                task.wait(1)
            end
        end)
    elseif cachedData.Type == "Temporary" and cachedData.Expire and tick() < cachedData.Expire then
        keyFrame.Visible = false
        main.Visible = true
        keyTimerLabel.Visible = true
        
        task.spawn(function()
            while true do
                local timeLeft = cachedData.Expire - tick()
                if timeLeft > 0 then
                    local h = math.floor(timeLeft / 3600)
                    local m = math.floor((timeLeft % 3600) / 60)
                    local s = math.floor(timeLeft % 60)
                    keyTimerLabel.Text = string.format("🔑 Key còn: %02d:%02d:%02d", h, m, s)
                else
                    clearKeyData()
                    keyTimerLabel.Text = "❌ Key đã hết hạn!"
                    keyTimerLabel.TextColor3 = Color3.fromRGB(230, 60, 60)
                    main.Visible = false
                    gui:Destroy()
                    break
                end
                task.wait(1)
            end
        end)
    else
        clearKeyData()
    end
end

--==================================================
-- HỆ THỐNG XÁC THỰC KEY MỚI
--==================================================
enter.MouseButton1Click:Connect(function()
    local enteredKey = input.Text:gsub("%s+", "")
    
    if enteredKey == "tien-keyvinhvien" then
        saveKeyData("Permanent", 0)
        keyStatusText.TextColor3 = Color3.fromRGB(46, 204, 113)
        keyStatusText.Text = "⭐ Thành công: Key Vĩnh Viễn!"
        task.wait(0.5)
        keyFrame:Destroy()
        main.Visible = true
        keyTimerLabel.Visible = true
        
        task.spawn(function()
            while true do
                keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"
                task.wait(1)
            end
        end)
        
    elseif enteredKey ~= "" and string.len(enteredKey) >= 4 then
        local expireTime = tick() + 21600
        saveKeyData("Temporary", expireTime)
        
        keyStatusText.TextColor3 = Color3.fromRGB(46, 204, 113)
        keyStatusText.Text = "✅ Thành công (Hạn 6 tiếng)!"
        task.wait(0.5)
        keyFrame:Destroy()
        main.Visible = true
        keyTimerLabel.Visible = true
        
        task.spawn(function()
            while true do
                local timeLeft = expireTime - tick()
                if timeLeft > 0 then
                    local h = math.floor(timeLeft / 3600)
                    local m = math.floor((timeLeft % 3600) / 60)
                    local s = math.floor(timeLeft % 60)
                    keyTimerLabel.Text = string.format("🔑 Key còn: %02d:%02d:%02d", h, m, s)
                else
                    clearKeyData()
                    keyTimerLabel.Text = "❌ Key đã hết hạn & bị xóa!"
                    keyTimerLabel.TextColor3 = Color3.fromRGB(230, 60, 60)
                    main.Visible = false
                    gui:Destroy()
                    break
                end
                task.wait(1)
            end
        end)
    else
        clearKeyData()
        keyStatusText.TextColor3 = Color3.fromRGB(230, 60, 60)
        keyStatusText.Text = "❌ Sai Key hợp lệ! Vui lòng lấy link GetKey."
    end
end)

