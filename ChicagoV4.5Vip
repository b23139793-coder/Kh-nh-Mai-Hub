addButton(exp, "📦 AUTO GIAO THÙNG HÀNG", 175, function(state)
    autoBoxDelivery = state
    task.spawn(function()
        while autoBoxDelivery do
            task.wait(0.15)
            pcall(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                for _, descendant in pairs(Workspace:GetDescendants()) do
                    if descendant:IsA("ProximityPrompt") then
                        local promptPart = descendant.Parent
                        if promptPart and promptPart:IsA("BasePart") then
                            local nameLower = descendant.Name:lower()
                            local parentNameLower = promptPart.Name:lower()
                            
                            if nameLower:find("box") or nameLower:find("thùng") or nameLower:find("deliver") or 
                               parentNameLower:find("box") or parentNameLower:find("thùng") or parentNameLower:find("delivery") then
                                
                                descendant.HoldDuration = 0
                                if (char.HumanoidRootPart.Position - promptPart.Position).Magnitude <= 20 then
                                    fireproximityprompt(descendant)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

addButton(exp, "💰 AUTO FARM MONEY", 230, function(state)
    autoFarmMoney = state
    task.spawn(function()
        while autoFarmMoney do
            task.wait(0.2)
            pcall(function()
                for _, descendant in pairs(Workspace:GetDescendants()) do
                    if descendant:IsA("ProximityPrompt") then
                        descendant.HoldDuration = 0
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local promptPart = descendant.Parent
                            if promptPart and promptPart:IsA("BasePart") then
                                if (player.Character.HumanoidRootPart.Position - promptPart.Position).Magnitude <= 15 then
                                    fireproximityprompt(descendant)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

addButton(exp, "🔫 AUTO FARM KILL", 285, function(state)
    autoFarmKill = state
    task.spawn(function()
        while autoFarmKill do
            task.wait(0.5)
            pcall(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                local backpack = player:FindFirstChildOfClass("Backpack")
                if backpack then
                    for _, tool in pairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("súng") or tool:FindFirstChild("Handle")) then
                            tool.Parent = char
                        end
                    end
                end

                local target = nil
                local shortestDist = math.huge
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                        local dist = (char.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            target = plr.Character
                        end
                    end
                end

                if target and target:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    local activeTool = char:FindFirstChildOfClass("Tool")
                    if activeTool then
                        activeTool:Activate()
                    end
                end
            end)
        end
    end)
end)

addButton(exp, "🚗 AUTO STEAL CAR", 340, function(state)
    autoStealCar = state
    task.spawn(function()
        while autoStealCar do
            task.wait(1)
            pcall(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("VehicleSeat") or (obj:IsA("Seat") and obj.Parent:FindFirstChild("Body")) then
                            if (player.Character.HumanoidRootPart.Position - obj.Position).Magnitude < 30 then
                                obj:Sit(player.Character.Humanoid)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

