local function updateDurationSelection(mode)
    selectedDurationMode = mode
    local buttons = {
        {btn = btn1Week, m = "1week"},
        {btn = btn2Weeks, m = "2week"},
        {btn = btn1Month, m = "1month"},
        {btn = btn3Months, m = "3month"},
        {btn = btnPermAdmin, m = "perm"}
    }
    for _, item in ipairs(buttons) do
        if item.m == mode then
            item.btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            item.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            item.btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            item.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end

