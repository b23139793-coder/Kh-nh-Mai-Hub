-- HỆ THỐNG HIỆU ỨNG SAO BĂNG & HOA RƠI
-- ==========================================

-- Tạo hạt hoa rơi
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(math.random(30, 70) / 100) -- Tần suất rơi
        
        local petal = Instance.new("Frame")
        petal.Size = UDim2.new(0, math.random(8, 14), 0, math.random(8, 14))
        petal.Position = UDim2.new(math.random(0, 100) / 100, 0, -0.05, 0)
        petal.BackgroundColor3 = Color3.fromRGB(255, 180, 205)
        petal.BackgroundTransparency = 0.3
        petal.Parent = ParticleContainer
        petal.ZIndex = 1

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0) -- Tạo hình cánh hoa tròn/oval
        corner.Parent = petal

        local randomX = math.random(-150, 150)
        local fallDuration = math.random(4, 7)

        local twInfo = TweenInfo.new(fallDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
        local tw = TweenService:Create(petal, twInfo, {
            Position = UDim2.new(petal.Position.X.Scale, randomX, 1.05, 0),
            Rotation = math.random(180, 720),
            BackgroundTransparency = 1
        })
        tw:Play()
        tw.Completed:Connect(function()
            petal:Destroy()
        end)
    end
end)

-- Tạo hiệu ứng sao băng chéo màn hình
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(math.random(15, 35) / 10) -- Thời gian giữa các lần sao băng xuất hiện
        
        local shootingStar = Instance.new("Frame")
        shootingStar.Size = UDim2.new(0, math.random(80, 140), 0, 2)
        -- Vị trí xuất phát từ góc trên bên phải chéo xuống trái
        local startX = math.random(50, 120) / 100
        local startY = math.random(-10, 20) / 100
        shootingStar.Position = UDim2.new(startX, 0, startY, 0)
        shootingStar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        shootingStar.BorderSizePixel = 0
        shootingStar.Rotation = 35 -- Góc nghiêng sao băng
        shootingStar.Parent = ParticleContainer
        shootingStar.ZIndex = 1

        -- Gradient tạo đuôi sao băng mờ dần
        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1)
        })
        grad.Parent = shootingStar

        local shootDuration = math.random(60, 100) / 100
        local twInfo = TweenInfo.new(shootDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tw = TweenService:Create(shootingStar, twInfo, {
            Position = UDim2.new(startX - 0.7, 0, startY + 0.7, 0),
            BackgroundTransparency = 1
        })
        tw:Play()
        tw.Completed:Connect(function()
            shootingStar:Destroy()
        end)
    end
end)
