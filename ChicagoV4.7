-- KEY SYSTEM LOGIC
local function startMainUI()
    keyFrame.Visible = false
    adminPanel.Visible = false
    toggleAdminPanelBtn.Visible = false
    main.Visible = true
    keyTimerLabel.Visible = true
    showWelcomeNotification()
end

local function startAdminUI()
    keyFrame.Visible = false
    main.Visible = true
    adminPanel.Visible = true
    toggleAdminPanelBtn.Visible = true
    keyTimerLabel.Visible = true
    showWelcomeNotification()
end

local function handleTimer(expTime, labelText)
    task.spawn(function()
        while true do
            local timeLeft = expTime - tick()
            if timeLeft > 0 then
                local days = math.floor(timeLeft / 86400)
                local rem = timeLeft % 86400
                local h = math.floor(rem / 3600)
                local m = math.floor((rem % 3600) / 60)
                local s = math.floor(rem % 60)
                if days > 0 then
                    keyTimerLabel.Text = string.format("🔑 Key %s: %d ngày %02d:%02d:%02d", labelText, days, h, m, s)
                else
                    keyTimerLabel.Text = string.format("🔑 Key %s: %02d:%02d:%02d", labelText, h, m, s)
                end
            else
                clearKeyData()
                main.Visible = false
                adminPanel.Visible = false
                gui:Destroy()
                break
            end
            task.wait(1)
        end
    end)
end

local cachedData = loadKeyData()
if cachedData then
    if cachedData.Type == "AdminMaster" then
        startAdminUI()
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Trạng thái: QUYỀN ADMIN"; task.wait(1) end end)
    elseif cachedData.Type == "Permanent" then
        startMainUI()
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end end)
    elseif cachedData.Expire and tick() < cachedData.Expire then
        startMainUI()
        handleTimer(cachedData.Expire, "còn")
    else
        clearKeyData()
        keyFrame.Visible = true
    end
else
    keyFrame.Visible = true
end

enter.MouseButton1Click:Connect(function()
    local enteredKey = input.Text:gsub("%s+", "")
    if enteredKey == "" then
        keyStatusText.Text = "❌ Vui lòng không để trống ô Key!"
        return
    end

    if enteredKey == "tien-adminmaster" then
        saveKeyData("AdminMaster", 0)
        startAdminUI()
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Trạng thái: QUYỀN ADMIN"; task.wait(1) end end)
    elseif enteredKey == "tien-keyvinhvien" or string.find(enteredKey, "PERM") then
        saveKeyData("Permanent", 0)
        startMainUI()
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end end)
    elseif string.find(enteredKey, "1W") then
        local expTime = tick() + (7 * 86400)
        saveKeyData("1Week", expTime)
        startMainUI()
        handleTimer(expTime, "1 Tuần")
    elseif string.find(enteredKey, "2W") then
        local expTime = tick() + (14 * 86400)
        saveKeyData("2Week", expTime)
        startMainUI()
        handleTimer(expTime, "2 Tuần")
    elseif string.find(enteredKey, "1M") then
        local expTime = tick() + (30 * 86400)
        saveKeyData("1Month", expTime)
        startMainUI()
        handleTimer(expTime, "1 Tháng")
    elseif string.find(enteredKey, "3M") then
        local expTime = tick() + (90 * 86400)
        saveKeyData("3Month", expTime)
        startMainUI()
        handleTimer(expTime, "3 Tháng")
    elseif #enteredKey >= 4 then
        local expTime = tick() + (24 * 3600)
        saveKeyData("WebKey", expTime)
        startMainUI()
        handleTimer(expTime, "Vượt Link (24h)")
    else
        keyStatusText.Text = "❌ Key không hợp lệ! Vui lòng kiểm tra lại."
    end
end)

