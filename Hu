	if not value then

		SpeedBox.Text =
			tostring(FlySpeed)

		return
	end

	FlySpeed =
		math.clamp(
			value,
			MIN_FLY_SPEED,
			MAX_FLY_SPEED
		)

	SpeedBox.Text =
		tostring(FlySpeed)

	SpeedLabel.Text =
		"Fly Speed: " ..
		tostring(FlySpeed)

end)

--============================================================
-- KEY CHECK
--============================================================

local function CheckKey(key)

	if not key then
		return nil
	end

	key =
		key:gsub("^%s+", "")
			:gsub("%s+$", "")

	return VALID_KEYS[key]
end

local function FormatTime(seconds)

	if seconds == math.huge then
		return "Vĩnh Viễn"
	end

	local days =
		math.floor(seconds / 86400)

	local hours =
		math.floor((seconds % 86400) / 3600)

	local minutes =
		math.floor((seconds % 3600) / 60)

	local secs =
		math.floor(seconds % 60)

	return string.format(
		"%d ngày %02d:%02d:%02d",
		days,
		hours,
		minutes,
		secs
	)
end

--============================================================
-- LOGIN
--============================================================

local function Login(key, duration)

	CurrentKey = key
	KeyStartTime = os.time()
	KeyDuration = duration

	KeyFrame.Visible = false
	MainFrame.Visible = true

	Status.Text = "Key hợp lệ!"
	Status.TextColor3 =
		Color3.fromRGB(70, 220, 110)

	KeyStatus.Text =
		"Key: " .. FormatTime(duration)

end

--============================================================
-- CHECK BUTTON
--============================================================

CheckButton.MouseButton1Click:Connect(function()

	local Key =
		KeyInput.Text

	Key =
		Key:gsub("^%s+", "")
			:gsub("%s+$", "")

	if Key == "" then

		Status.Text =
			"Vui lòng nhập Key!"

		Status.TextColor3 =
			Color3.fromRGB(255, 180, 60)

		return
	end

	local Duration =
		CheckKey(Key)

	if not Duration then

		Status.Text =
			"✕ Key không hợp lệ"

		Status.TextColor3 =
			Color3.fromRGB(255, 70, 70)

		InputStroke.Color =
			Color3.fromRGB(255, 70, 70)

		CheckButton.Text =
			"KEY SAI"

		task.delay(1.2, function()

			if CheckButton.Parent then

				CheckButton.Text =
					"CHECK KEY"

				InputStroke.Color =
					Color3.fromRGB(
						100,
						100,
						115
					)

				Status.Text =
					"Vui lòng nhập Key"

				Status.TextColor3 =
					Color3.fromRGB(
						180,
						180,
						195
					)
			end

		end)

		return
	end

	-- Key đúng

	CheckButton.Text =
		"✓ KEY ĐÚNG"

	CheckButton.BackgroundColor3 =
		Color3.fromRGB(45, 180, 85)

	InputStroke.Color =
		Color3.fromRGB(45, 180, 85)

	task.wait(0.4)

	Login(
		Key,
		Duration
	)

end)

