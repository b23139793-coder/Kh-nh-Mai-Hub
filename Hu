--============================================================
-- KEY TIMER
--============================================================

task.spawn(function()

	while Gui.Parent do

		if CurrentKey
			and KeyDuration
			and KeyDuration ~= math.huge
			and KeyStartTime then

			local Remaining =
				KeyDuration -
				(os.time() - KeyStartTime)

			if Remaining <= 0 then

				StopFly()

				CurrentKey = nil
				KeyStartTime = nil
				KeyDuration = nil

				MainFrame.Visible = false
				FlyPanel.Visible = false
				KeyFrame.Visible = true

				KeyInput.Text = ""

				Status.Text =
					"Key đã hết hạn!"

				Status.TextColor3 =
					Color3.fromRGB(
						255,
						70,
						70
					)

			else

				KeyStatus.Text =
					"Key: " ..
					FormatTime(Remaining)

			end

		elseif CurrentKey
			and KeyDuration == math.huge then

			KeyStatus.Text =
				"Key: Vĩnh Viễn"
		end

		task.wait(1)
	end

end)

