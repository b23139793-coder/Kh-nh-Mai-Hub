local function createCard(parent, name, defaultState, callback)
    local card = Instance.new("TextButton", parent)
    card.BackgroundColor3, card.Text, card.AutoButtonColor = Color3.fromRGB(28, 28, 35), "", false
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
    local label = Instance.new("TextLabel", card)
    label.Size, label.Position, label.BackgroundTransparency, label.Text = UDim2.new(0.8, 0, 1, 0), UDim2.new(0, 10, 0, 0), 1, name .. " 🌸"
    label.TextColor3, label.Font, label.TextXAlignment = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150), Enum.Font.SourceSansBold, Enum.TextXAlignment.Left
    local arrow = Instance.new("TextLabel", card)
    arrow.Size, arrow.Position, arrow.BackgroundTransparency, arrow.Text = UDim2.new(0.2, 0, 1, 0), UDim2.new(0.8, 0, 0, 0), 1, "▶"
    arrow.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(100, 100, 100)
    local state = defaultState
    card.MouseButton1Click:Connect(function()
        state = not state
        label.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
        arrow.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(100, 100, 100)
        callback(state)
    end)
end

