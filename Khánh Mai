local function getClosestPlayer(partName)
    local closest, shortestDistance = nil, Settings.FOVSize
    for _, v in pairs(Players:GetPlayers()) do
        if isEnemy(v) and v.Character and v.Character:FindFirstChild(partName) and v.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(v.Character[partName].Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                if dist < shortestDistance then shortestDistance, closest = dist, v end
            end
        end
    end
    return closest
end

local ESP_Cache = {}
local function createESP(player)
    local tracer, box, nameTag = Drawing.new("Line"), Drawing.new("Square"), Drawing.new("Text")
    tracer.Thickness, box.Thickness, box.Filled = 1.5, 1, false
    nameTag.Color, nameTag.Size, nameTag.Center, nameTag.Outline = Color3.fromRGB(255, 255, 255), 14, true, true
    ESP_Cache[player] = {Tracer = tracer, Box = box, Name = nameTag}
end

local function removeESP(player)
    if ESP_Cache[player] then
        ESP_Cache[player].Tracer:Remove() ESP_Cache[player].Box:Remove() ESP_Cache[player].Name:Remove()
        ESP_Cache[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then createESP(p) end end)
Players.PlayerRemoving:Connect(removeESP)

local spinAngle = 0
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    hue = (hue + 0.005 > 1) and 0 or hue + 0.005
    local activeColor = getCurrentColor()
    
    KeyStroke.Color, MainStroke.Color, ToggleStroke.Color, FOVCircle.Color = activeColor, activeColor, activeColor, activeColor
    PlayerCountText.Text, PlayerCountText.Position = tostring(#Players:GetPlayers()), Vector2.new(Camera.ViewportSize.X / 2, 10)

    -- SpinBot Logic
    if Settings.SpinBot and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        spinAngle = spinAngle + Settings.SpinSpeed
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    end

    -- Hitbox Logic (Chỉ tác động lên Kẻ Địch)
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = v.Character.HumanoidRootPart
            if Settings.Hitbox and isEnemy(v) then
                hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                hrp.Transparency = 0.7
                hrp.BrickColor = BrickColor.new("Medium reddish violet")
                hrp.Material = Enum.Material.Neon
                hrp.CanCollide = false
            else
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.CanCollide = true
            end
        end
    end

    -- Aim Logic
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        local targetPart = Settings.AimHead and "Head" or (Settings.AimTorso and "HumanoidRootPart" or nil)
        if targetPart then
            local target = getClosestPlayer(targetPart)
            if target and target.Character and target.Character:FindFirstChild(targetPart) then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character[targetPart].Position)
            end
        end
    end

    -- ESP Loop (Chỉ vẽ ESP trên Kẻ Địch hoặc người chơi ngoài trận)
    for player, drawings in pairs(ESP_Cache) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
                drawings.Tracer.Visible, drawings.Tracer.Color = Settings.ESP_Tracer, activeColor
                drawings.Tracer.From, drawings.Tracer.To = Vector2.new(Camera.ViewportSize.X / 2, 0), Vector2.new(pos.X, pos.Y)

                drawings.Box.Visible, drawings.Box.Color = Settings.ESP_Box, activeColor
                local sizeY = (Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position - Vector3.new(0, 3.5, 0)).Y)
                local sizeX = sizeY / 1.5
                drawings.Box.Size, drawings.Box.Position = Vector2.new(math.abs(sizeX), math.abs(sizeY)), Vector2.new(pos.X - math.abs(sizeX) / 2, pos.Y - math.abs(sizeY) / 2)

                drawings.Name.Visible, drawings.Name.Text = Settings.ESP_Name, player.Name .. " 🌸"
                drawings.Name.Position = Vector2.new(pos.X, pos.Y - math.abs(sizeY) / 2 - 15)
            else
                drawings.Tracer.Visible, drawings.Box.Visible, drawings.Name.Visible = false, false, false
            end
        else
            drawings.Tracer.Visible, drawings.Box.Visible, drawings.Name.Visible = false, false, false
        end
    end
end)
