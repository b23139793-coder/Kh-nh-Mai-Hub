local PositionSection,PositionItems =
    createSection("POSITION")

local SavedPosition = nil

local SaveBtn =
    createButton(
        PositionItems,
        "📍 Lưu vị trí"
    )

SaveBtn.MouseButton1Click:Connect(function()

    local Character =
        Player.Character

    if not Character then return end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then return end

    SavedPosition =
        Root.CFrame

    SaveBtn.Text =
        "✓ Đã lưu vị trí"

    task.delay(1.2,function()

        if SaveBtn.Parent then
            SaveBtn.Text =
                "📍 Lưu vị trí"
        end

    end)

end)

local Flying = false
local FlySpeed = 1000

local FlyBtn =
    createButton(
        PositionItems,
        "🚀 Bay về vị trí: OFF"
    )

local FlyInput =
    createInput(
        PositionItems,
        "1000"
    )

FlyInput.PlaceholderText =
    "Fly Speed"

FlyInput.FocusLost:Connect(function()

    local n =
        tonumber(FlyInput.Text)

    if n then

        FlySpeed =
            math.clamp(n,50,5000)

        FlyInput.Text =
            tostring(FlySpeed)

    else

        FlyInput.Text =
            tostring(FlySpeed)

    end

end)

FlyBtn.MouseButton1Click:Connect(function()

    if Flying then

        Flying = false

        FlyBtn.Text =
            "🚀 Bay về vị trí: OFF"

        return
    end

    if not SavedPosition then

        FlyBtn.Text =
            "❌ Chưa lưu vị trí"

        task.delay(1,function()

            if FlyBtn.Parent then
                FlyBtn.Text =
                    "🚀 Bay về vị trí: OFF"
            end

        end)

        return
    end

    local Character =
        Player.Character

    if not Character then return end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then return end

    Flying = true

    FlyBtn.Text =
        "🚀 Đang bay..."

    task.spawn(function()

        while
            Flying
            and Root.Parent
            and SavedPosition
        do

            local Target =
                SavedPosition.Position

            local Current =
                Root.Position

            local Direction =
                Target - Current

            local Distance =
                Direction.Magnitude

            if Distance <= 3 then

                Root.CFrame =
                    SavedPosition

                Flying = false

                FlyBtn.Text =
                    "🚀 Bay về vị trí: OFF"

                break
            end

            local dt =
                RunService.Heartbeat:Wait()

            local MoveDistance =
                math.min(
                    FlySpeed * dt,
                    Distance
                )

            local NewPosition =
                Current +
                Direction.Unit *
                MoveDistance

            Root.CFrame =
                CFrame.new(
                    NewPosition
                ) *
                SavedPosition.Rotation

        end

    end)

end)

