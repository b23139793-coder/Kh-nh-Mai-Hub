local MovementSection,MovementItems =
    createSection("MOVEMENT")

local tpWalkEnabled = false
local tpWalkSpeed = 50

local TpWalkBtn =
    createButton(
        MovementItems,
        "TP Walk: OFF"
    )

local TpWalkInput =
    createInput(
        MovementItems,
        "50"
    )

TpWalkInput.PlaceholderText =
    "TP Walk Speed"

TpWalkInput.FocusLost:Connect(function()

    local n = tonumber(TpWalkInput.Text)

    if n then
        tpWalkSpeed =
            math.clamp(n,0,500)

        TpWalkInput.Text =
            tostring(tpWalkSpeed)
    else
        TpWalkInput.Text =
            tostring(tpWalkSpeed)
    end

end)

TpWalkBtn.MouseButton1Click:Connect(function()

    tpWalkEnabled =
        not tpWalkEnabled

    TpWalkBtn.Text =
        tpWalkEnabled
        and "TP Walk: ON"
        or "TP Walk: OFF"

end)

RunService.RenderStepped:Connect(function()

    if not tpWalkEnabled then return end

    local Character =
        Player.Character

    if not Character then return end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Root
        and Humanoid
        and Humanoid.MoveDirection.Magnitude > 0 then

        Root.CFrame =
            Root.CFrame +
            Humanoid.MoveDirection *
            (tpWalkSpeed / 30)

    end

end)

