local UtilitySection,UtilityItems =
    createSection("UTILITY")

local instantLootEnabled = false
local originalHoldDurations = {}

local InstantBtn =
    createButton(
        UtilityItems,
        "Instant Loot: OFF"
    )

local function MakePromptInstant(Prompt)

    if not Prompt:IsA(
        "ProximityPrompt"
    ) then
        return
    end

    if originalHoldDurations[Prompt]
        == nil then

        originalHoldDurations[Prompt] =
            Prompt.HoldDuration

    end

    Prompt.HoldDuration = 0

end

InstantBtn.MouseButton1Click:Connect(function()

    instantLootEnabled =
        not instantLootEnabled

    if instantLootEnabled then

        InstantBtn.Text =
            "Instant Loot: ON"

        for _,Object in ipairs(
            workspace:GetDescendants()
        ) do

            MakePromptInstant(Object)

        end

    else

        InstantBtn.Text =
            "Instant Loot: OFF"

        for Prompt,Duration in pairs(
            originalHoldDurations
        ) do

            if Prompt
                and Prompt.Parent then

                Prompt.HoldDuration =
                    Duration

            end

        end

        table.clear(
            originalHoldDurations
        )

    end

end)

ProximityPromptService.PromptShown:Connect(
    function(Prompt)

        if instantLootEnabled then
            MakePromptInstant(Prompt)
        end

    end
)

