    if decorFOV360Enabled then decorFOV360.Visible = true else decorFOV360.Visible = false end

    if godmodEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth
    end

    if noclipEnabled and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if gunColorMode ~= "Normal" and player.Character then
        pcall(function()
            for _, item in pairs(player.Character:GetChildren()) do
                if item:IsA("Tool") then
                    for _, subPart in pairs(item:GetDescendants()) do
                        if subPart:IsA("BasePart") then
                            subPart.Material = Enum.Material.Glass
                            subPart.Transparency = 0.4
                            if gunColorMode == "BlueGlass" then subPart.Color = Color3.fromRGB(52, 152, 219)
                            elseif gunColorMode == "RedGlass" then subPart.Color = Color3.fromRGB(231, 76, 60) end
                        end
                    end
                end
            end
        end)
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if redChamsEnabled and char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hl = redChamsHighlights[plr]
                if not hl or not hl.Parent then
                    hl = Instance.new("Highlight")
                    hl.Name = "TienRedChamsHighlight"
                    hl.Adornee = char
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.FillTransparency = 0.45
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0.1
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char
                    redChamsHighlights[plr] = hl
                end
            else
                if redChamsHighlights[plr] then
                    redChamsHighlights[plr]:Destroy()
                    redChamsHighlights[plr] = nil
                end
            end
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if hitboxEnabled then
                    hrp.Size = Vector3.new(hitboxRadius, hitboxRadius, hitboxRadius)
                    hrp.CanCollide = false
                    
                    if not hitboxVisuals[plr] or not hitboxVisuals[plr].Parent then
                        local sphere = Instance.new("Part")
                        sphere.Name = "TienHitboxVisual"
                        sphere.Shape = Enum.PartType.Ball
                        sphere.Material = Enum.Material.Neon
                        sphere.Color = Color3.fromRGB(255, 50, 50)
                        sphere.Transparency = 0.7
                        sphere.CanCollide = false
                        sphere.Anchored = false
                        sphere.Parent = plr.Character
                        
                        local weld = Instance.new("WeldConstraint")
                        weld.Part0 = hrp
                        weld.Part1 = sphere
                        weld.Parent = sphere
                        hitboxVisuals[plr] = sphere
                    end
                    if hitboxVisuals[plr] then
                        hitboxVisuals[plr].Size = Vector3.new(hitboxRadius, hitboxRadius, hitboxRadius)
                        hitboxVisuals[plr].Transparency = 0.65
                    end
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    if hitboxVisuals[plr] then
                        hitboxVisuals[plr]:Destroy()
                        hitboxVisuals[plr] = nil
                    end
                end
            else
                if hitboxVisuals[plr] then
                    hitboxVisuals[plr]:Destroy()
                    hitboxVisuals[plr] = nil
                end
            end
        end
    end

    if aimbotEnabled then
        local closestTarget = nil
        local shortestDist = fovRadius
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                if not (teamCheckEnabled and player.Team and plr.Team and player.Team == plr.Team) then
                    local targetPart = plr.Character:FindFirstChild(aimTargetPart) or plr.Character.HumanoidRootPart
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - gameCenter).Magnitude
                        if mouseDist < shortestDist then
                            local canLock = true
                            if wallCheckEnabled then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                                rayParams.FilterDescendantsInstances = {player.Character, Camera}
                                local rayResult = Workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rayParams)
                                if rayResult and not rayResult.Instance:IsDescendantOf(plr.Character) then
                                    canLock = false
                                end
                            end
                            if canLock then
                                shortestDist = mouseDist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end
        if closestTarget then Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position) end
    end

    local humanCount, robotCount = 0, 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")

            if not char or not hrp or not humanoid or humanoid.Health <= 0 then
                if espCache[plr] then
                    espCache[plr].Box.Visible = false
                    espCache[plr].Tracer.Visible = false
                    espCache[plr].HealthBarBg.Visible = false
                    espCache[plr].HealthBarFill.Visible = false
                end
            else
                if Players:GetPlayerFromCharacter(char) then humanCount = humanCount + 1 else robotCount = robotCount + 1 end

                if not espCache[plr] then
                    espCache[plr] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        HealthBarBg = Drawing.new("Square"),
                        HealthBarFill = Drawing.new("Square")
                    }
                    espCache[plr].Box.Visible = false; espCache[plr].Box.Thickness = 1.5; espCache[plr].Box.Color = Color3.fromRGB(255, 255, 255); espCache[plr].Box.Filled = false
                    espCache[plr].Tracer.Visible = false; espCache[plr].Tracer.Thickness = 1.5; espCache[plr].Tracer.Color = Color3.fromRGB(255, 255, 255)
                    espCache[plr].HealthBarBg.Visible = false; espCache[plr].HealthBarBg.Filled = true; espCache[plr].HealthBarBg.Color = Color3.fromRGB(30, 30, 30)
                    espCache[plr].HealthBarFill.Visible = false; espCache[plr].HealthBarFill.Filled = true; espCache[plr].HealthBarFill.Color = Color3.fromRGB(0, 255, 0)
                end

                local cache = espCache[plr]
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen and anyEspActive then
                    local boxSize = Vector2.new(2200 / vector.Z, 3300 / vector.Z)
                    local boxPos = Vector2.new(vector.X - boxSize.X / 2, vector.Y - boxSize.Y / 2)

                    if espBoxesEnabled then cache.Box.Visible = true; cache.Box.Size = boxSize; cache.Box.Position = boxPos else cache.Box.Visible = false end
                    if espTracersEnabled then
                        cache.Tracer.Visible = true
                        cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                        cache.Tracer.To = Vector2.new(vector.X, vector.Y)
                    else cache.Tracer.Visible = false end

                    if espHealthEnabled then
                        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        local barHeight = boxSize.Y
                        cache.HealthBarBg.Visible = true
                        cache.HealthBarBg.Size = Vector2.new(3.5, barHeight)
                        cache.HealthBarBg.Position = Vector2.new(boxPos.X - 6, boxPos.Y)

                        cache.HealthBarFill.Visible = true
                        cache.HealthBarFill.Size = Vector2.new(3.5, barHeight * healthPercent)
                        cache.HealthBarFill.Position = Vector2.new(boxPos.X - 6, boxPos.Y + (barHeight - (barHeight * healthPercent)))
                    else
                        cache.HealthBarBg.Visible = false; cache.HealthBarFill.Visible = false
                    end
                else
                    cache.Box.Visible = false; cache.Tracer.Visible = false; cache.HealthBarBg.Visible = false; cache.HealthBarFill.Visible = false
                end
            end
        end
    end
    counterLabel.Text = string.format("👤 %d   🤖 %d", humanCount, robotCount)
end)
