-- APP ICON INTERACTION
appIconButton.MouseButton1Click:Connect(function()
    blackScreen.Visible = false
    infoTopLabel.Visible = true
    
    local cachedData = loadKeyData()
    if cachedData then
        if cachedData.Type == "AdminMaster" then
            adminSectionContainer.Visible = true
            main.Visible = true
            keyTimerLabel.Visible = true
            task.spawn(function() while true do keyTimerLabel.Text = "🔑 Trạng thái: QUYỀN ADMIN"; task.wait(1) end end)
            showWelcomeNotification()
        elseif cachedData.Type == "Permanent" then
            main.Visible = true
            keyTimerLabel.Visible = true
            task.spawn(function() while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end end)
            showWelcomeNotification()
        elseif cachedData.Expire and tick() < cachedData.Expire then
            main.Visible = true
            keyTimerLabel.Visible = true
            task.spawn(function()
                while true do
                    local rem = cachedData.Expire - tick()
                    if rem > 0 then
                        local days = math.floor(rem / 86400)
                        local r = rem % 86400
                        local h = math.floor(r / 3600)
                        local m = math.floor((r % 3600) / 60)
                        local s = math.floor(r % 60)
                        if days > 0 then
                            keyTimerLabel.Text = string.format("🔑 Key: %d ngày %02d:%02d:%02d", days, h, m, s)
                        else
                            keyTimerLabel.Text = string.format("🔑 Key: %02d:%02d:%02d", h, m, s)
                        end
                    else
                        clearKeyData()
                        main.Visible = false
                        gui:Destroy()
                        break
                    end
                    task.wait(1)
                end
            end)
            showWelcomeNotification()
        else
            clearKeyData()
            keyFrame.Visible = true
        end
    else
        keyFrame.Visible = true
    end
end)

enter.MouseButton1Click:Connect(function()
    local enteredKey = input.Text:gsub("%s+", "")
    if enteredKey == "" then
        keyStatusText.Text = "❌ Vui lòng không để trống ô Key!"
        return
    end

    if enteredKey == "tien-adminmaster" then
        saveKeyData("AdminMaster", 0, 0)
        keyFrame.Visible = false
        main.Visible = true
        adminSectionContainer.Visible = true
        keyTimerLabel.Visible = true
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Trạng thái: QUYỀN ADMIN"; task.wait(1) end end)
        showWelcomeNotification()
    elseif enteredKey == "tien-keyvinhvien" or string.find(enteredKey, "PERM") then
        saveKeyData("Permanent", 0, 0)
        keyFrame.Visible = false
        main.Visible = true
        keyTimerLabel.Visible = true
        task.spawn(function() while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end end)
        showWelcomeNotification()
    else
        local expTime = tick() + (24 * 3600)
        saveKeyData("WebKey", expTime, 1)
        keyFrame.Visible = false
        main.Visible = true
        keyTimerLabel.Visible = true
        showWelcomeNotification()
    end
end)

