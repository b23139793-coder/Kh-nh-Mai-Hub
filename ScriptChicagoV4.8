local function saveKeyData(keyType, expireTime, maxDevices)
    pcall(function()
        if writefile and isfolder then
            local data = HttpService:JSONEncode({Type = keyType, Expire = expireTime, MaxDevices = maxDevices or 0})
            writefile(KEY_CACHE_FILE, data)
        end
    end)
end

local function loadKeyData()
    local success, res = pcall(function()
        if readfile and isfile and isfile(KEY_CACHE_FILE) then
            local raw = readfile(KEY_CACHE_FILE)
            return HttpService:JSONDecode(raw)
        end
    end)
    if success and res then return res end
    return nil
end

local function clearKeyData()
    pcall(function()
        if delfile and isfile and isfile(KEY_CACHE_FILE) then
            delfile(KEY_CACHE_FILE)
        end
    end)
end

local function makeDraggable(topbarObject, object)
    local dragging, dragInput, dragStart, startPos
    topbarObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    topbarObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function safeTeleportTo(targetCFrame)
    pcall(function()
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        local seat = nil
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("Seat") or part:IsA("VehicleSeat") then
                if part.Occupant == char:FindFirstChild("Humanoid") then
                    seat = part
                    break
                end
            end
        end
        if not seat then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("VehicleSeat") and obj.Occupant and obj.Occupant.Parent == char then
                    seat = obj
                    break
                end
            end
        end
        
        if seat and seat.Parent then
            local vehicleModel = seat.Parent
            local primaryPart = vehicleModel.PrimaryPart or vehicleModel:FindFirstChild("HumanoidRootPart") or seat
            for _, part in pairs(vehicleModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
            if vehicleModel.SetPrimaryPartCFrame and vehicleModel.PrimaryPart then
                vehicleModel:SetPrimaryPartCFrame(targetCFrame + Vector3.new(0, 4, 0))
            else
                primaryPart.CFrame = targetCFrame + Vector3.new(0, 4, 0)
            end
        else
            char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            char.HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 3, 0)
        end
    end)
end

-- HIỆU ỨNG SAO BĂNG RỚT XUỐNG & TIA SÁNG QUÉT NGANG CHO UI
local function applyVisualEffects(targetFrame)
    -- Hiệu ứng sao băng rớt xuống (Falling Stars)
    task.spawn(function()
        while targetFrame and targetFrame.Parent do
            task.wait(math.random(1.5, 3))
            pcall(function()
                local star = Instance.new("Frame", targetFrame)
                star.Size = UDim2.fromOffset(math.random(2, 4), math.random(15, 30))
                star.Position = UDim2.new(math.random(0, 100)/100, 0, -0.1, 0)
                star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                star.BackgroundTransparency = 0.3
                star.BorderSizePixel = 0
                star.ZIndex = 5
                Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)

                local tweenInfo = TweenInfo.new(math.random(15, 25) / 10, Enum.EasingStyle.Linear)
                local tw = TweenService:Create(star, tweenInfo, {
                    Position = UDim2.new(star.Position.X.Scale, math.random(-30, 30), 1.1, 0),
                    BackgroundTransparency = 1
                })
                tw:Play()
                tw.Completed:Connect(function()
                    star:Destroy()
                end)
            end)
        end
    end)

    -- Hiệu ứng tia sáng quét ngang (Shimmer Effect)
    task.spawn(function()
        while targetFrame and targetFrame.Parent do
            pcall(function()
                local shimmer = Instance.new("Frame", targetFrame)
                shimmer.Size = UDim2.new(0, 40, 1, 0)
                shimmer.Position = UDim2.new(-0.2, 0, 0, 0)
                shimmer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                shimmer.BackgroundTransparency = 0.85
                shimmer.BorderSizePixel = 0
                shimmer.Rotation = 25
                shimmer.ZIndex = 4
                
                local gradient = Instance.new("UIGradient", shimmer)
                gradient.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.5, 0.3),
                    NumberSequenceKeypoint.new(1, 1)
                })

                local tw = TweenService:Create(shimmer, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = UDim2.new(1.2, 0, 0, 0)
                })
                tw:Play()
                tw.Completed:Connect(function()
                    shimmer:Destroy()
                end)
            end)
            task.wait(5)
        end
    end)
end

