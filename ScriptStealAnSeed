local function SetPrompt(p)

    if not p:IsA("ProximityPrompt") then return end

    if Original[p]==nil then
        Original[p]=p.HoldDuration
    end

    p.HoldDuration=0
end

LootB.MouseButton1Click:Connect(function()

    Instant=not Instant

    if Instant then

        LootB.Text="⚡ INSTANT LOOT: ON"
        LootB.BackgroundTransparency=.60

        for _,v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                SetPrompt(v)
            end
        end

    else

        LootB.Text="⚡ INSTANT LOOT: OFF"
        LootB.BackgroundTransparency=.85

        for p,value in pairs(Original) do
            if p and p.Parent then
                p.HoldDuration=value
            end
        end

        table.clear(Original)
    end
end)

PPS.PromptShown:Connect(function(p)
