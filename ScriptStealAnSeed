local Saved=nil
local Flying=false
local FlySpeed=500
local FlyTween=nil

local SaveB=MakeButton(Pages.POS,"📍 SAVE POSITION",18)
local FlyB=MakeButton(Pages.POS,"🚀 FLY TO POSITION: OFF",73)
local FlyBox=MakeBox(Pages.POS,"500","Fly Speed 50 - 5000",128)

SaveB.MouseButton1Click:Connect(function()

    local char=Player.Character
    if not char then return end

    local root=char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    Saved=root.CFrame
    SaveB.Text="✅ POSITION SAVED"

    task.delay(1.5,function()
        if SaveB.Parent then
            SaveB.Text="📍 SAVE POSITION"
        end
    end)
end)

FlyBox.FocusLost:Connect(function()
    local n=tonumber(FlyBox.Text)
    if n then FlySpeed=math.clamp(n,50,5000) end
    FlyBox.Text=tostring(FlySpeed)
end)

FlyB.MouseButton1Click:Connect(function()

    if Flying then
        Flying=false

        if FlyTween then
            FlyTween:Cancel()
            FlyTween=nil
        end

        FlyB.Text="🚀 FLY TO POSITION: OFF"
        return
    end

    if not Saved then
        FlyB.Text="❌ SAVE A POSITION FIRST"

        task.delay(1,function()
            if FlyB.Parent then
                FlyB.Text="🚀 FLY TO POSITION: OFF"
            end
        end)

        return
    end

    local char=Player.Character
    if not char then return end

    local root=char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    Flying=true
    FlyB.Text="🚀 FLYING..."

    local distance=(root.Position-Saved.Position).Magnitude
    local duration=math.clamp(distance/FlySpeed,.25,8)

    FlyTween=TweenService:Create(
        root,
        TweenInfo.new(duration,Enum.EasingStyle.Linear),
        {CFrame=Saved}
    )

    FlyTween.Completed:Connect(function(state)

        if state==Enum.PlaybackState.Completed
        and root.Parent then
            root.CFrame=Saved
        end

        Flying=false
        FlyTween=nil

        if FlyB.Parent then
            FlyB.Text="🚀 FLY TO POSITION: OFF"
        end
    end)

    FlyTween:Play()
end)

