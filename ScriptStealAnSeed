    task.spawn(function()

        local ok,err=pcall(function()

            local url=
                "https://games.roblox.com/v1/games/"
                ..game.PlaceId..
                "/servers/Public?sortOrder=Asc&limit=100"

            local data=HttpService:JSONDecode(
                game:HttpGet(url)
            )

            local list={}

            for _,s in ipairs(data.data or {}) do
                if s.id~=game.JobId
                and s.playing<s.maxPlayers then
                    table.insert(list,s)
                end
            end

            if #list==0 then
                error("No server found")
            end

            table.sort(list,function(a,b)
                return a.playing<b.playing
            end)

            ServerB.Text="🚀 JOINING..."

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                list[1].id,
                Player
            )
        end)

        if not ok then
            warn("[HUMAN HUB]",err)
            ServerB.Text="❌ SERVER ERROR"

            task.wait(2)

            if ServerB.Parent then
                ServerB.Text="🌐 SERVER HOP"
            end
        end

        Hopping=false
    end)
end)

