local function ScanEggs()

    EggInfo.Text="Scanning visible objects..."

    local results={}
    local count=0

    for _,obj in ipairs(workspace:GetDescendants()) do

        local n=string.lower(obj.Name)

        if string.find(n,"egg")
        or string.find(n,"pet")
        or string.find(n,"rare")
        or string.find(n,"legend") then

            count=count+1

            if count<=12 then
                table.insert(results,"• "..obj.Name)
            end
        end
    end

    if #results==0 then

        EggInfo.Text=
            "No visible egg-related objects found.\n\n"..
            "The game may keep egg data server-side."

    else

        EggInfo.Text=
            "VISIBLE OBJECTS FOUND: "..count..
            "\n\n"..
            table.concat(results,"\n")
    end
end

