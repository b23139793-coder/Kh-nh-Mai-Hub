local unlocked=false

local function Unlock()

    if unlocked then return end

    if KeyBox.Text==VALID_KEY then

        unlocked=true
        KeyStatus.Text="✓ ACCESS GRANTED"
        KeyStatus.TextColor3=Color3.fromRGB(120,255,170)

        task.wait(.35)

        KeyFrame.Visible=false
        Toggle.Visible=true

        ShowLoading(function()
            Main.Visible=true
        end)

    else

        KeyStatus.Text="✕ INVALID KEY"
        KeyStatus.TextColor3=Color3.fromRGB(255,100,120)

        KeyBox.Text=""

        task.wait(.8)

        KeyStatus.Text=""
    end
end

Verify.MouseButton1Click:Connect(Unlock)

KeyBox.FocusLost:Connect(function(enter)
    if enter then
        Unlock()
    end
end)

