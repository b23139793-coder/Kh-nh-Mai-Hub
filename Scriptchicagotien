local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Filled = false
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Transparency = 0.8

RunService.RenderStepped:Connect(function()
    -- Xử lý Tốc độ chạy & Noclip
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if speedEnabled then
            LocalPlayer.Character.Humanoid.WalkSpeed = customSpeed
        end
    end

    if noclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Xử lý Aimbot & FOV
    if aimHeadEnabled then
        FOVCircle.Visible = true
        FOVCircle.Radius = fovSize
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        local closestTarget = nil
        local shortestDist = fovSize
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                local head = plr.Character.Head
                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if mouseDist < shortestDist then
                        shortestDist = mouseDist
                        closestTarget = head
                    end
                end
            end
        end
        
        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    else
        FOVCircle.Visible = false
    end

    -- Xử lý Hitbox
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            if hitboxEnabled then
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                hrp.Transparency = 0.6
                hrp.CanCollide = false
            else
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end

    -- Xử lý ESP
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local char = plr.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid
            
            if not espCache[plr] then
                espCache[plr] = {
                    Box = Drawing.new("Square"),
                    Tracer = Drawing.new("Line"),
                    Info = Drawing.new("Text")
                }
                espCache[plr].Box.Visible = false
                espCache[plr].Box.Thickness = 1.5
                espCache[plr].Box.Color = Color3.fromRGB(255, 50, 50)
                espCache[plr].Box.Filled = false

                espCache[plr].Tracer.Visible = false
                espCache[plr].Tracer.Thickness = 1.5
                espCache[plr].Tracer.Color = Color3.fromRGB(255, 255, 255)

                espCache[plr].Info.Visible = false
                espCache[plr].Info.Size = 13
                espCache[plr].Info.Center = true
                espCache[plr].Info.Outline = true
                espCache[plr].Info.Color = Color3.fromRGB(255, 255, 255)
            end

            local cache = espCache[plr]
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                if espBoxesEnabled then
                    cache.Box.Visible = true
                    cache.Box.Size = Vector2.new(2500 / vector.Z, 3500 / vector.Z)
                    cache.Box.Position = Vector2.new(vector.X - cache.Box.Size.X / 2, vector.Y - cache.Box.Size.Y / 2)
                else
                    cache.Box.Visible = false
                end

                if espTracersEnabled then
                    cache.Tracer.Visible = true
                    cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    cache.Tracer.To = Vector2.new(vector.X, vector.Y)
                else
                    cache.Tracer.Visible = false
                end

                if espHealthNameEnabled then
                    cache.Info.Visible = true
                    cache.Info.Text = string.format("%s\n[HP: %d/%d]", plr.Name, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
                    cache.Info.Position = Vector2.new(vector.X, vector.Y - (3500 / vector.Z) / 2 - 30)
                else
                    cache.Info.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.Tracer.Visible = false
                cache.Info.Visible = false
            end
        else
            cleanESP(plr)
        end
    end
end)
