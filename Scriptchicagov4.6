--==================================================
-- KEY SYSTEM LOGIC
--==================================================
local function startMainUI()
    keyFrame:Destroy()
    main.Visible = true
    keyTimerLabel.Visible = true
    showWelcomeNotification()
end

local function handleTimer(expTime, labelText)
    task.spawn(function()
        while true do
            local timeLeft = expTime - tick()
            if timeLeft > 0 then
                local days = math.floor(timeLeft / 86400)
                local remAfterDays = timeLeft % 86400
                local h = math.floor(remAfterDays / 3600)
                local m = math.floor((remAfterDays % 3600) / 60)
                local s = math.floor(remAfterDays % 60)
                
                if days > 0 then
                    keyTimerLabel.Text = string.format("🔑 Key %s: %d ngày %02d:%02d:%02d", labelText, days, h, m, s)
                else
                    keyTimerLabel.Text = string.format("🔑 Key %s: %02d:%02d:%02d", labelText, h, m, s)
                end
            else
                clearKeyData()
                main.Visible = false
                gui:Destroy()
                break
            end
            task.wait(1)
        end
    end)
end

local cachedData = loadKeyData()
if cachedData then
    if cachedData.Type == "Permanent" then
        startMainUI()
        task.spawn(function()
            while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end
        end)
    elseif cachedData.Expire and tick() < cachedData.Expire then
        startMainUI()
        handleTimer(cachedData.Expire, "còn")
    else
        clearKeyData()
    end
end

enter.MouseButton1Click:Connect(function()
    local enteredKey = input.Text:gsub("%s+", "")
    if enteredKey == "" then
        keyStatusText.TextColor3 = Color3.fromRGB(230, 60, 60)
        keyStatusText.Text = "❌ Vui lòng không để trống ô Key!"
        return
    end

    if enteredKey == "tien-keyvinhvien" then
        saveKeyData("Permanent", 0)
        startMainUI()
        task.spawn(function()
            while true do keyTimerLabel.Text = "🔑 Key: Vĩnh Viễn (∞)"; task.wait(1) end
        end)
    elseif enteredKey == "tien-key3day" then
        local expTime = tick() + (3 * 86400)
        saveKeyData("3Day", expTime)
        startMainUI()
        handleTimer(expTime, "3 Ngày")
    elseif enteredKey == "tien-key1tuan" then
        local expTime = tick() + (7 * 86400)
        saveKeyData("1Week", expTime)
        startMainUI()
        handleTimer(expTime, "1 Tuần")
    elseif enteredKey == "tien-key3tuan" then
        local expTime = tick() + (21 * 86400)
        saveKeyData("3Weeks", expTime)
        startMainUI()
        handleTimer(expTime, "3 Tuần")
    elseif enteredKey == "tien-key1thang" then
        local expTime = tick() + (30 * 86400)
        saveKeyData("1Month", expTime)
        startMainUI()
        handleTimer(expTime, "1 Tháng")
    elseif enteredKey == "tien-key2thang" then
        local expTime = tick() + (60 * 86400)
        saveKeyData("2Months", expTime)
        startMainUI()
        handleTimer(expTime, "2 Tháng")
    else
        if string.find(enteredKey, "http://") or string.find(enteredKey, "https://") then
            keyStatusText.TextColor3 = Color3.fromRGB(230, 160, 40)
            keyStatusText.Text = "⚠️ Bạn đang dán Link web! Hãy dán mã Key nhận được."
        elseif #enteredKey >= 4 then
            local expTime = tick() + (24 * 3600)
            saveKeyData("WebKey", expTime)
            startMainUI()
            handleTimer(expTime, "Vượt Link (24h)")
        else
            keyStatusText.TextColor3 = Color3.fromRGB(230, 60, 60)
            keyStatusText.Text = "❌ Key không hợp lệ! Vui lòng kiểm tra lại."
        end
    end
end)

