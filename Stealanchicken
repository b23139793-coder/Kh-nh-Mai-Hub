--========================================
-- INSTANT LOOT
--========================================

local function InstantPrompt(prompt)

    if not prompt:IsA("ProximityPrompt") then return end

    if Original[prompt] == nil then
        Original[prompt] = prompt.HoldDuration
    end

    prompt.HoldDuration = 0
end

LootBtn.MouseButton1Click:Connect(function()

    Instant = not Instant

    if Instant then

        LootBtn.Text = "⚡ INSTANT LOOT: ON"
        LootBtn.BackgroundTransparency = 0.60

        for _,v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                InstantPrompt(v)
            end
        end

    else

        LootBtn.Text = "⚡ INSTANT LOOT: OFF"
        LootBtn.BackgroundTransparency = 0.82

        for prompt,value in pairs(Original) do

            if prompt and prompt.Parent then
                prompt.HoldDuration = value
            end

        end

        table.clear(Original)
    end
end)

ProximityPromptService.PromptShown:Connect(function(prompt)

    if Instant then
        InstantPrompt(prompt)
    end
end)

--========================================
-- SERVER HOP
--========================================

local Hopping = false

ServerBtn.MouseButton1Click:Connect(function()

    if Hopping then return end

    Hopping = true
    ServerBtn.Text = "🔎 ĐANG TÌM SERVER..."

    task.spawn(function()

        local ok,err = pcall(function()

            local url =
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"

            local raw = game:HttpGet(url)
            local data = HttpService:JSONDecode(raw)

            local list = {}

            for _,server in ipairs(data.data or {}) do

                if server.id ~= game.JobId
                and server.playing < server.maxPlayers then

                    table.insert(list,server)
                end
            end

            if #list == 0 then
                error("Không tìm thấy server")
            end

            table.sort(list,function(a,b)
                return a.playing < b.playing
            end)

            local target = list[1]

            ServerBtn.Text =
                "🚀 ĐANG VÀO SERVER..."

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                target.id,
                Player
            )
        end)

        if not ok then

            warn("[TÈO PANEL] SERVER HOP:",err)

            ServerBtn.Text =
                "❌ SERVER HOP LỖI"

            task.wait(2)

            if ServerBtn.Parent then
                ServerBtn.Text = "🌐 SERVER HOP"
            end
        end

        Hopping = false
    end)
end)

