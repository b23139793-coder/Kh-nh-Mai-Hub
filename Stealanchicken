local PosPage = Page("POS")

local Saved = nil
local Flying = false
local FlySpeed = 500

local SaveBtn = Button(PosPage,"📍 LƯU VỊ TRÍ",20)
local FlyBtn = Button(PosPage,"🚀 BAY TỚI VỊ TRÍ: OFF",75)
local FlyBox = Input(PosPage,"500","Fly Speed 50 - 5000",130)

SaveBtn.MouseButton1Click:Connect(function()

    local char = Player.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    Saved = root.CFrame
    SaveBtn.Text = "✅ ĐÃ LƯU"

    task.delay(1.5,function()
        if SaveBtn.Parent then
            SaveBtn.Text = "📍 LƯU VỊ TRÍ"
        end
    end)
end)

FlyBox.FocusLost:Connect(function()

    local n = tonumber(FlyBox.Text)

    if n then
        FlySpeed = math.clamp(n,50,5000)
    end

    FlyBox.Text = tostring(FlySpeed)
end)

local function MoveTo(root,target)

    while Flying and root.Parent do

        local current = root.Position
        local delta = target-current
        local distance = delta.Magnitude

        if distance <= 3 then
            root.CFrame = CFrame.new(target)
            return true
        end

        local dt = RunService.Heartbeat:Wait()
        local step = math.min(FlySpeed*dt,distance)

        root.CFrame =
            CFrame.new(current + delta.Unit*step)
    end

    return false
end

FlyBtn.MouseButton1Click:Connect(function()

    if Flying then
        Flying = false
        FlyBtn.Text = "🚀 BAY TỚI VỊ TRÍ: OFF"
        return
    end

    if not Saved then
        FlyBtn.Text = "❌ CHƯA LƯU"
        task.delay(1,function()
            if FlyBtn.Parent then
                FlyBtn.Text = "🚀 BAY TỚI VỊ TRÍ: OFF"
            end
        end)
        return
    end

    local char = Player.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    Flying = true
    FlyBtn.Text = "🚀 ĐANG BAY..."

    task.spawn(function()

        local start = root.Position
        local target = Saved.Position

        local highY =
            math.max(start.Y,target.Y) + 100

        -- LÊN CAO
        if not MoveTo(
            root,
            Vector3.new(start.X,highY,start.Z)
        ) then return end

        -- BAY NGANG
        if not MoveTo(
            root,
            Vector3.new(target.X,highY,target.Z)
        ) then return end

        -- HẠ XUỐNG
        MoveTo(root,target)

        if Flying then
            root.CFrame = Saved
        end

        Flying = false

        if FlyBtn.Parent then
            FlyBtn.Text = "🚀 BAY TỚI VỊ TRÍ: OFF"
        end
    end)
end)

