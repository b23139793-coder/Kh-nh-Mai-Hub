--==================================================
-- RENDER LOOP & RAINBOW EFFECT
--==================================================
RunService.RenderStepped:Connect(function()
    local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
    mainStroke.Color = rainbowColor
    keyStroke.Color = rainbowColor

    local gameCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    aimFOV.Position = gameCenter
    centerDot.Position = gameCenter

    if godmodEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth
    end

    if noclipEnabled and player.Character then
        local parts = player.Character:GetDescendants()
        for i = 1, #parts do
            local part = parts[i]
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- AIMBOT LOGIC
    if aimHeadEnabled then
        local closestTarget = nil
        local shortestDist = fovRadius

        local allPlayers = Players:GetPlayers()
        for i = 1, #allPlayers do
            local plr = allPlayers[i]
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                
                local isTeamMate = false
                if teamCheckEnabled and player.Team and plr.Team and player.Team == plr.Team then
                    isTeamMate = true
                end

                if not isTeamMate then
                    local targetPart = plr.Character:FindFirstChild("Head") or plr.Character.HumanoidRootPart
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - gameCenter).Magnitude
                        if mouseDist < shortestDist then
                            
                            local passesWallCheck = true
                            if wallCheckEnabled then
                                local raycastParams = RaycastParams.new()
                                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                                raycastParams.IgnoreWater = true
                                
                                local ignoreList = {player.Character}
                                if plr.Character then
                                    table.insert(ignoreList, plr.Character)
                                end
                                raycastParams.FilterDescendantsInstances = ignoreList

                                local direction = targetPart.Position - Camera.CFrame.Position
                                local raycastResult = Workspace:Raycast(Camera.CFrame.Position, direction, raycastParams)
                                
                                if raycastResult then
                                    passesWallCheck = false
                                end
                            end

                            if passesWallCheck then
                                shortestDist = mouseDist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end

    -- Hitbox Logic
    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local plr = allPlayers[i]
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            if hitboxEnabled then
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                hrp.Transparency = 0.6
                hrp.CanCollide = false
            else
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end

    -- ESP & Counter Logic
    local humanCount = 0
    local robotCount = 0
    local activePlayersMap = {}

    for i = 1, #allPlayers do
        local plr = allPlayers[i]
        activePlayersMap[plr] = true

        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local char = plr.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid

            local isRobot = plr.Name:lower():find("bot") or plr.Name:lower():find("npc") or not Players:GetPlayerFromCharacter(char)
            if isRobot then
                robotCount = robotCount + 1
            else
                humanCount = humanCount + 1
            end

            if not espCache[plr] then
                espCache[plr] = {
                    Box = Drawing.new("Square"),
                    Tracer = Drawing.new("Line"),
                    Info = Drawing.new("Text")
                }
                espCache[plr].Box.Visible = false
                espCache[plr].Box.Thickness = 1.5
                espCache[plr].Box.Color = Color3.fromRGB(255, 60, 60)
                espCache[plr].Box.Filled = false

                espCache[plr].Tracer.Visible = false
                espCache[plr].Tracer.Thickness = 1.5
                espCache[plr].Tracer.Color = Color3.fromRGB(255, 255, 255)

                espCache[plr].Info.Visible = false
                espCache[plr].Info.Size = 13
                espCache[plr].Info.Center = true
                espCache[plr].Info.Outline = true
                espCache[plr].Info.Color = Color3.fromRGB(255, 255, 255)
            end

            local cache = espCache[plr]
            local vector, onSchool = Camera:WorldToViewportPoint(hrp.Position)

            if onSchool and anyEspActive then
                if espBoxesEnabled then
                    cache.Box.Visible = true
                    cache.Box.Size = Vector2.new(2500 / vector.Z, 3500 / vector.Z)
                    cache.Box.Position = Vector2.new(vector.X - cache.Box.Size.X / 2, vector.Y - cache.Box.Size.Y / 2)
                else
                    cache.Box.Visible = false
                end

                if espTracersEnabled then
                    cache.Tracer.Visible = true
                    cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    cache.Tracer.To = Vector2.new(vector.X, vector.Y)
                else
                    cache.Tracer.Visible = false
                end

                if espHealthNameEnabled then
                    cache.Info.Visible = true
                    cache.Info.Text = string.format("%s\n[HP: %d/%d]", plr.Name, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
                    cache.Info.Position = Vector2.new(vector.X, vector.Y - (3500 / vector.Z) / 2 - 30)
                else
                    cache.Info.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.Tracer.Visible = false
                cache.Info.Visible = false
            end
        else
            if espCache[plr] then
                espCache[plr].Box.Visible = false
                espCache[plr].Tracer.Visible = false
                espCache[plr].Info.Visible = false
            end
        end
    end

    for cachedPlr, _ in pairs(espCache) do
        if not activePlayersMap[cachedPlr] then
            cleanESP(cachedPlr)
        end
    end

    if anyEspActive then
        counterLabel.Text = string.format("👤 %d   🤖 %d", humanCount, robotCount)
    end
end)
