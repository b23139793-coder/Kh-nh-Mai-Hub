addButton(aim, "🔫 VÔ HẠN ĐẠN ", 65, function(state)
    infiniteAmmoEnabled = state
    task.spawn(function()
        while infiniteAmmoEnabled do
            task.wait(0.2)
            pcall(function()
                -- Cách 1: Quét hệ thống bàn cờ / Garbage Collector đặc thù của game súng Chicago
                if getgc and setreadonly and rawset then
                    for _, obj in next, getgc(true) do
                        if type(obj) == "table" then
                            if rawget(obj, "Ammo") and rawget(obj, "MaxAmmo") then
                                if isreadonly(obj) then
                                    setreadonly(obj, false)
                                end
                                rawset(obj, "Ammo", 99999)
                                rawset(obj, "MaxAmmo", 99999)
                            end
                        end
                    end
                end

                -- Cách 2: Quét trực tiếp các thuộc tính trong Tool / Backpack phòng hờ
                local function scanAndFix(container)
                    if not container then return end
                    for _, obj in pairs(container:GetChildren()) do
                        if obj:IsA("Tool") then
                            for _, v in pairs(obj:GetDescendants()) do
                                if v:IsA("IntValue") or v:IsA("NumberValue") then
                                    local name = v.Name:lower()
                                    if name:find("ammo") or name:find("clip") or name:find("bullet") or name:find("magazine") or name:find("rounds") then
                                        v.Value = 99999
                                    end
                                end
                            end
                        end
                    end
                end

                if player.Character then
                    scanAndFix(player.Character)
                end
                local backpack = player:FindFirstChildOfClass("Backpack")
                if backpack then
                    scanAndFix(backpack)
                end
            end)
        end
    end)
end)

