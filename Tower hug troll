--// =========================================================
--// FILE FUNCTIONS
--// =========================================================

local function SaveKeyData(key, startTime)
    if writefile then
        pcall(function()
            writefile(
                SAVE_FILE_NAME,
                HttpService:JSONEncode({
                    Key = key,
                    StartTime = startTime
                })
            )
        end)
    end
end

local function LoadKeyData()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(
                readfile(SAVE_FILE_NAME)
            )
        end)

        if success and result then
            return result
        end
    end

    return nil
end

local function ClearKeyData()
    if delfile and isfile and isfile(SAVE_FILE_NAME) then
        pcall(function()
            delfile(SAVE_FILE_NAME)
        end)
    end
end

local function SaveCustomKeys()
    if writefile then
        pcall(function()
            writefile(
                CUSTOM_KEYS_FILE,
                HttpService:JSONEncode(ValidKeys)
            )
        end)
    end
end

local function LoadCustomKeys()
    if readfile and isfile and isfile(CUSTOM_KEYS_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(
                readfile(CUSTOM_KEYS_FILE)
            )
        end)

        if success and result then
            for key, value in pairs(result) do
                ValidKeys[key] = value
            end
        end
    end
end

LoadCustomKeys()

--// =========================================================
--// KEY CHECK
--// =========================================================

local function CheckValidKey(keyInput)

    if not keyInput
        or type(keyInput) ~= "string" then
        return nil
    end

    if ValidKeys[keyInput] then
        return ValidKeys[keyInput]
    end

    if string.match(
        keyInput,
        "^INF%-1D%-[A-Z0-9]+%-[A-Z0-9]+%-[A-Z0-9]+$"
    ) then
        return 86400
    end

    return nil
end

--// =========================================================
--// UI HELPERS
--// =========================================================

local function Corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = object
    return c
end

local function Stroke(object, thickness)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 2
    s.Parent = object
    return s
end

local function CreateButton(parent, text, height)
    local button = Instance.new("TextButton")
    button.Parent = parent
    button.Size = UDim2.new(1, 0, 0, height or 36)
    button.Text = text
    button.BackgroundColor3 =
        Color3.fromRGB(28, 28, 40)
    button.TextColor3 =
        Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.AutoButtonColor = true

    Corner(button, 8)

    return button
end

