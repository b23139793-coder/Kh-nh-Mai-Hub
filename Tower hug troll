BindHold(RiseButton, "Up")
BindHold(FallButton, "Down")

--// =========================================================
--// FLY SYSTEM
--// =========================================================

local FlyVelocity = nil
local FlyGyro = nil

local function StopFly()

    FlyEnabled = false

    -- Ngắt RenderStepped
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    -- Xóa BodyVelocity
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    -- Xóa BodyGyro
    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    -- Reset toàn bộ nút
    for name in pairs(MobileInput) do
        MobileInput[name] = false
    end

    local character = LocalPlayer.Character

    if character then

        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.PlatformStand = false
        end
    end

    FlyToggle.Text = "FLY OFF"

    FlyToggle.BackgroundColor3 =
        Color3.fromRGB(35, 35, 48)

end

local function StartFly()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return
    end

    -- Nếu đang Fly thì không tạo thêm
    if FlyEnabled then
        return
    end

    FlyEnabled = true

    --// BodyVelocity
    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "InfinitiFlyVelocity"

    FlyVelocity.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyVelocity.P = 9000
    FlyVelocity.Velocity =
        Vector3.zero

    FlyVelocity.Parent = root

    --// BodyGyro
    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.Name = "InfinitiFlyGyro"

    FlyGyro.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyGyro.P = 9000
    FlyGyro.D = 500
    FlyGyro.CFrame =
        root.CFrame

    FlyGyro.Parent = root

    humanoid.PlatformStand = true

    FlyToggle.Text = "FLY ON"

    FlyToggle.BackgroundColor3 =
        Color3.fromRGB(46, 204, 113)

    --// =====================================================
    --// FLY LOOP
    --// =====================================================

    FlyConnection =
        RunService.RenderStepped:Connect(function()

            if not FlyEnabled then
                return
            end

            if not character.Parent
                or not root.Parent
                or humanoid.Health <= 0 then

                StopFly()
                return
            end

            local camera =
                workspace.CurrentCamera

            if not camera then
                return
            end

            local direction =
                Vector3.zero

            --// =============================================
            --// MOBILE INPUT
            --// =============================================

            if MobileInput.Forward then
                direction +=
                    camera.CFrame.LookVector
            end

            if MobileInput.Backward then
                direction -=
                    camera.CFrame.LookVector
            end

            if MobileInput.Left then
                direction -=
                    camera.CFrame.RightVector
            end

            if MobileInput.Right then
                direction +=
                    camera.CFrame.RightVector
            end

            if MobileInput.Up then
                direction +=
                    Vector3.new(0, 1, 0)
            end

            if MobileInput.Down then
                direction -=
                    Vector3.new(0, 1, 0)
            end

            --// =============================================
            --// PC INPUT
            --// =============================================

            if UserInputService:IsKeyDown(
                Enum.KeyCode.W
            ) then

                direction +=
                    camera.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.S
            ) then

                direction -=
                    camera.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.A
            ) then

                direction -=
                    camera.CFrame.RightVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.D
            ) then

                direction +=
                    camera.CFrame.RightVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.Space
            ) then

                direction +=
                    Vector3.new(0, 1, 0)
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.LeftControl
            ) then

                direction -=
                    Vector3.new(0, 1, 0)
            end

            --// =============================================
            --// APPLY VELOCITY
            --// =============================================

            if direction.Magnitude > 0 then

                direction =
                    direction.Unit

                FlyVelocity.Velocity =
                    direction * FlySpeed

            else

                FlyVelocity.Velocity =
                    Vector3.zero
            end

            --// =============================================
            --// XOAY NHÂN VẬT THEO CAMERA
            --// =============================================

            local look =
                camera.CFrame.LookVector

            local horizontalLook =
                Vector3.new(
                    look.X,
                    0,
                    look.Z
                )

            if horizontalLook.Magnitude > 0 then

                horizontalLook =
                    horizontalLook.Unit

                FlyGyro.CFrame =
                    CFrame.lookAt(
                        root.Position,
                        root.Position +
                            horizontalLook
                    )
            end

        end)
end

