local function FormatTime(seconds)

    if seconds == math.huge then
        return "Vĩnh Viễn"
    end

    seconds =
        math.max(
            0,
            math.floor(seconds)
        )

    local days =
        math.floor(
            seconds / 86400
        )

    local hours =
        math.floor(
            (seconds % 86400) / 3600
        )

    local minutes =
        math.floor(
            (seconds % 3600) / 60
        )

    local secs =
        seconds % 60

    if days > 0 then

        return string.format(
            "%d Ngày %02d:%02d:%02d",
            days,
            hours,
            minutes,
            secs
        )

    end

    return string.format(
        "%02d:%02d:%02d",
        hours,
        minutes,
        secs
    )
end

local function StartTimer(
    key,
    startTime
)

    local duration =
        ValidKeys[key]
        or CheckValidKey(key)

    if not duration then
        return
    end

    TimerFrame.Visible = true

    if TimerThread then

        task.cancel(
            TimerThread
        )
    end

    TimerThread =
        task.spawn(function()

            while true do

                if duration == math.huge then

                    TimerText.Text =
                        "Key: Vĩnh Viễn"

                    break
                end

                local remaining =
                    duration -
                    (
                        os.time()
                        - startTime
                    )

                if remaining <= 0 then

                    Logout()
                    break
                end

                TimerText.Text =
                    "Key: " ..
                    FormatTime(
                        remaining
                    )

                task.wait(1)

            end
        end)
end

