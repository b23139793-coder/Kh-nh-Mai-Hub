-- Hàm kiểm tra key (Nhận diện định dạng INF-1D- từ trang web HTML mới)
local function CheckValidKey(keyInput)
    if not keyInput or type(keyInput) ~= "string" then return nil end
    
    if ValidKeys[keyInput] then
        return ValidKeys[keyInput]
    end
    
    -- Nhận diện Key 1 Ngày từ trang web (Định dạng: INF-1D-XXXXX-XXXXX-XXXXX)
    if string.match(keyInput, "^INF%-1D%-[A-Z0-9]+%-[A-Z0-9]+%-[A-Z0-9]+$") then
        return 86400 -- 24 giờ tính bằng giây
    end
    
    return nil
end

