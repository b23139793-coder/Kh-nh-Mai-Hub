local function FormatTime(seconds)
    if seconds == math.huge then return "Vĩnh Viễn" end
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return days > 0 and string.format("%d Ngày %02d:%02d:%02d", days, hours, mins, secs) or string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function StartTimer(key, startTime)
    local maxDuration = ValidKeys[key] or CheckValidKey(key)
    TimerFrame.Visible = true
    if timerThread then task.cancel(timerThread) end

    timerThread = task.spawn(function()
        while true do
            local remainingTime = maxDuration - (os.time() - startTime)
            if maxDuration == math.huge then
                TimerText.Text = "Thời gian Key: Vĩnh Viễn"
                break
            end
            if remainingTime <= 0 then Logout() break end
            TimerText.Text = "Thời gian Key: " .. FormatTime(remainingTime)
            task.wait(1)
        end
    end)
end

local function AuthenticateKey(key, startTime)
    KeyFrame.Visible = false
    if key == "INFI-ADMIN-9999" then
        HDToggleButton.Visible = true
        AdminFrame.Visible = true
        CurrentActiveFrame = AdminFrame
    else
        UserToggleButton.Visible = true
        MainFrame.Visible = true
        CurrentActiveFrame = MainFrame
    end
    StartTimer(key, startTime)
end

local savedData = LoadKeyData()
if savedData and savedData.Key then
    local duration = ValidKeys[savedData.Key] or CheckValidKey(savedData.Key)
    if duration then
        if duration == math.huge or (os.time() - savedData.StartTime) < duration then
            AuthenticateKey(savedData.Key, savedData.StartTime)
        else
            ClearKeyData()
        end
    end
end

SubmitBtn.MouseButton1Click:Connect(function()
    local inputKey = KeyInput.Text
    local keyDuration = CheckValidKey(inputKey)
    
    if keyDuration then
        SubmitBtn.Text = "Key Đúng!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        task.wait(0.8)
        
        local currentTime = os.time()
        SaveKeyData(inputKey, currentTime)
        ValidKeys[inputKey] = keyDuration
        AuthenticateKey(inputKey, currentTime)
        
        SubmitBtn.Text = "Check Key"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(140, 80, 255)
    else
        KeyInput.Text = ""
        KeyInput.PlaceholderText = "Sai Key! Thử lại..."
        InputStroke.Color = Color3.fromRGB(255, 70, 70)
        SubmitBtn.Text = "Key Sai!"
        task.wait(1.5)
        InputStroke.Color = Color3.fromRGB(45, 45, 60)
        SubmitBtn.Text = "Check Key"
    end
end)

