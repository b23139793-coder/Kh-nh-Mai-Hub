-- 0. HÀM QUẢN LÝ FILE DATA (LƯU/TẢI KEY)
-- -------------------------------------------------------------
local function SaveKeyData(key, startTime)
    if writefile then
        pcall(function() writefile(SAVE_FILE_NAME, HttpService:JSONEncode({Key = key, StartTime = startTime})) end)
    end
end

local function LoadKeyData()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE_NAME)) end)
        if success and result then return result end
    end
    return nil
end

local function ClearKeyData()
    if delfile and isfile and isfile(SAVE_FILE_NAME) then
        pcall(function() delfile(SAVE_FILE_NAME) end)
    end
end

local function SaveCustomKeys()
    if writefile then
        pcall(function() writefile(CUSTOM_KEYS_FILE, HttpService:JSONEncode(ValidKeys)) end)
    end
end

local function LoadCustomKeys()
    if readfile and isfile and isfile(CUSTOM_KEYS_FILE) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(CUSTOM_KEYS_FILE)) end)
        if success and result then
            for k, v in pairs(result) do ValidKeys[k] = v end
        end
    end
end

